# Install as /etc/tover/backup.env with mode 0600; never store the API token here.
# local captures app data only; selectel also creates a billed full-VM backup.
TOVER_BACKUP_MODE=local
# The server ID scopes local backup names in both modes.
SELECTEL_SERVER_ID=REPLACE_WITH_NUMERIC_SERVER_ID
SELECTEL_TOKEN_FILE=/etc/tover/selectel.token
TOVER_BACKUP_ROOT=/srv/tover-backups
TOVER_BACKUP_KEEP_LOCAL=7
# Use the same private environment as the running installation.
TOVER_ENV_FILE=/etc/tover/app.env
