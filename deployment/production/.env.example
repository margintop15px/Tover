# Copy with ./production.sh init. Keep the resulting .env private (0600).
# Runtime defaults target an 8 GiB VM: 4 GiB app limit, 2 GiB JVM heap.
# All services rotate Docker logs at 10 MiB per file, retaining 3 files each.
TOVER_DEPLOYMENT_NAME=tover-production
TOVER_APP_IMAGE=tover:tester-20261023-selectel
TOVER_DOMAIN=inventory.example.com
TOVER_ORIGIN=https://inventory.example.com
ACME_EMAIL=admin@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# Single-quote provider passwords containing $, # or spaces.
SMTP_PASS=
SMTP_ADMIN_EMAIL=auth@example.com
SMTP_SENDER_NAME=Tover
POSTGRES_PASSWORD=GENERATE
TOVER_DB_PASSWORD=GENERATE
JWT_SECRET=GENERATE
ANON_KEY=GENERATE
SERVICE_ROLE_KEY=GENERATE
SESSION_ENCRYPTION_KEY=GENERATE
