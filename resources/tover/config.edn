;; Read by tover.app/config. #tover/env is optional, #tover/required fails startup when unset,
;; #tover/when [condition value] keeps a key only when the condition holds.
{:tover.app/repo          {:path #or [#tover/env "TOVER_INVENTORY_PATH"
                                      #profile {:dev ".data/tester-inventory-v1" :default ".data/inventory-v1"}]}
 :tover.app/logging       {:env #profile {:dev :dev :default :prod}}
 :tover.app/provider      {:auth-url  #tover/required "TOVER_AUTH_URL"
                           :api-key   #tover/required "TOVER_API_KEY"
                           :admin-key #tover/required "TOVER_AUTH_ADMIN_KEY"}
 :tover.app/session-store {:datasource #ig/ref :tover.app/datasource :encryption-key #tover/required "TOVER_SESSION_KEY"}
 :tover.app/realtime      {:provider      #ig/ref :tover.app/provider
                           :session-store #ig/ref :tover.app/session-store
                           :repo          #ig/ref :tover.app/repo
                           :logging       #ig/ref :tover.app/logging}
 :tover.app/handler       {:repo            #ig/ref :tover.app/repo
                           :realtime        #ig/ref :tover.app/realtime
                           :provider        #ig/ref :tover.app/provider
                           :session-store   #ig/ref :tover.app/session-store
                           :logging         #ig/ref :tover.app/logging
                           :bel/system      #ig/ref :tover.app/bel-system
                           :origin          #tover/required "TOVER_ORIGIN"
                           :development?    #profile {:dev true :default false}
                           :identity-health {:auth-url   #tover/required "TOVER_AUTH_URL"
                                             :api-key    #tover/required "TOVER_API_KEY"
                                             :datasource #ig/ref :tover.app/datasource}}
 :tover.app/server        {:repo          #ig/ref :tover.app/repo
                           :handler       #ig/ref :tover.app/handler
                           :realtime      #ig/ref :tover.app/realtime
                           :session-store #ig/ref :tover.app/session-store
                           :port          #tover/int ["TOVER_PORT" 3030]}

 [:bel-postgres.jdbc/datasource :tover.app/datasource]
 {:jdbc-url  #tover/required "TOVER_JDBC_URL"
  :user      #tover/required "TOVER_DB_USER"
  :password  #tover/required "TOVER_DB_PASSWORD"
  :pool-name "tover-identity"}

 [:bel-postgres.adapter/store :tover.app/directory]
 {:datasource #ig/ref :tover.app/datasource}

 [:bel-rdf.adapter/store :tover.app/catalogue]
 {:repo   #ig/ref :tover.app/repo
  :graphs tover.catalogues.persistence/graphs
  :guard  tover.catalogues.persistence/legacy-guard}

 [:bel/system :tover.app/bel-system]
 {:stores    {:directory #ig/ref :tover.app/directory :catalogue #ig/ref :tover.app/catalogue}
  :journal   :directory
  :scope     :workspace
  :authority {:store :directory :impl tover.identity.session/->CurrentSession}
  :resources {:realtime      #ig/ref :tover.app/realtime
              :provider      #ig/ref :tover.app/provider
              :session-store #ig/ref :tover.app/session-store
              :origin        #tover/required "TOVER_ORIGIN"
              :marketplace   #ig/ref :tover.marketplace.connector/connector}}

 ;; Ozon credentials are sealed with their own key; without TOVER_CONNECTOR_KEY connecting reports a configuration error.
 :tover.marketplace.connector/connector
 {:repo          #ig/ref :tover.app/repo
  :connector-key #tover/env "TOVER_CONNECTOR_KEY"}

 ;; The worker's private login: journal delivery and processors act as a service, not a user session.
 ;; Setting only one of the two journal variables is a configuration error. Not an Integrant key; config drops it.
 :tover/journal?          #or [#tover/env "TOVER_JOURNAL_DB_USER" #tover/env "TOVER_JOURNAL_DB_PASSWORD"]

 [:bel-postgres.jdbc/datasource :tover.app/journal-datasource]
 #tover/when [#ref [:tover/journal?]
              {:jdbc-url  #tover/required "TOVER_JDBC_URL"
               :user      #tover/required "TOVER_JOURNAL_DB_USER"
               :password  #tover/required "TOVER_JOURNAL_DB_PASSWORD"
               :pool-name "tover-journal"}]

 [:bel-postgres.adapter/store :tover.app/journal-directory]
 #tover/when [#ref [:tover/journal?]
              {:datasource #ig/ref :tover.app/journal-datasource}]

 [:bel-rdf.adapter/store :tover.app/journal-catalogue]
 #tover/when [#ref [:tover/journal?]
              {:repo #ig/ref :tover.app/repo :graphs tover.catalogues.persistence/graphs}]

 [:bel/system :tover.app/delivery-system]
 #tover/when [#ref [:tover/journal?]
              {:stores    {:directory #ig/ref :tover.app/journal-directory
                           :catalogue #ig/ref :tover.app/journal-catalogue}
               :journal   :directory
               :scope     :workspace
               ;; Without TOVER_SMTP_HOST invitation sends fail as recorded attempts.
               :resources {:mailer #tover/when [#tover/env "TOVER_SMTP_HOST" #ig/ref :tover.app/mailer]
                           :origin #tover/required "TOVER_ORIGIN"}}]

 :bel.delivery/worker
 #tover/when [#ref [:tover/journal?]
              #ig/ref :tover.app/delivery-system]

 :tover.app/mailer
 #tover/when [#tover/env "TOVER_SMTP_HOST"
              {:host        #tover/env "TOVER_SMTP_HOST"
               :port        #tover/int ["TOVER_SMTP_PORT" 587]
               :user        #tover/env "TOVER_SMTP_USER"
               :password    #tover/env "TOVER_SMTP_PASSWORD"
               :from        #tover/required "TOVER_SMTP_FROM"
               :sender-name #tover/env "TOVER_SMTP_SENDER_NAME"
               :starttls?   #tover/flag ["TOVER_SMTP_STARTTLS" true]}]}
